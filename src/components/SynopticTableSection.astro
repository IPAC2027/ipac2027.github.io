---
import type { Speaker } from '../data/speakers';
import { speakers } from '../data/speakers';
import { conferenceDays, tracks, getTrack, scheduleBreaks } from '../data/synopticSchedule';
import type { ScheduleBreak } from '../data/synopticSchedule';

// Group scheduled speakers by conference day
function getDaySpeakers(date: string): Speaker[] {
  return speakers
    .filter(s => s.schedule?.date === date)
    .sort((a, b) => (a.schedule?.startTime || '').localeCompare(b.schedule?.startTime || ''));
}

// All rooms used anywhere in the program, used as fixed grid columns so the
// matrix (and its empty placeholder slots) look the same on every day.
// Sorted alphabetically so "Ballroom A" always renders left of "Ballroom B".
const ALL_ROOMS = [...new Set(speakers.map(s => s.schedule?.room).filter(Boolean))].sort((a, b) =>
  (a as string).localeCompare(b as string)
) as string[];

function breakSlot(b: ScheduleBreak): string {
  return `${b.startTime}–${b.endTime}`;
}

// Distinct time slots actually scheduled on a given day (talks + timed
// breaks), used as the seed for the full, gap-filled grid rows below.
function getTimeSlots(daySpeakers: Speaker[], timedBreaks: ScheduleBreak[]): string[] {
  const slots = new Set(
    daySpeakers
      .filter(s => s.schedule?.startTime)
      .map(s => `${s.schedule!.startTime}${s.schedule?.endTime ? `–${s.schedule.endTime}` : ''}`)
  );
  timedBreaks.forEach(b => slots.add(breakSlot(b)));
  return [...slots].sort();
}

function speakersFor(daySpeakers: Speaker[], slot: string, room: string): Speaker[] {
  return daySpeakers.filter(s => {
    const sSlot = `${s.schedule?.startTime}${s.schedule?.endTime ? `–${s.schedule.endTime}` : ''}`;
    return sSlot === slot && s.schedule?.room === room;
  });
}

function timeToMinutes(t: string): number {
  const [h, m] = t.split(':').map(Number);
  return h * 60 + m;
}

function minutesToTime(min: number): string {
  const h = Math.floor(min / 60);
  const m = min % 60;
  return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
}

const SLOT_MINUTES = 30;

// Row height scales with slot duration so a 20-min talk visibly takes less
// vertical space than a 30-min one. Slots without a parsed end time (or with
// an end time before the start, e.g. bad data) fall back to 30 min.
const PX_PER_MINUTE = 2;
const MIN_ROW_PX = 40;

function slotDurationMinutes(slot: string): number {
  const [start, end] = slot.split('–');
  if (!start || !end) return 30;
  const minutes = timeToMinutes(end) - timeToMinutes(start);
  return minutes > 0 ? minutes : 30;
}

function slotRowHeightPx(slot: string): number {
  return Math.max(slotDurationMinutes(slot) * PX_PER_MINUTE, MIN_ROW_PX);
}

// Fill the [startMin, endMin) window with 30-min placeholder rows wherever
// there isn't already a real (talk/break) slot, so the time axis always
// reads at a constant pace even on days without a full program yet.
function buildDaySlots(realSlots: string[], startMin: number, endMin: number): string[] {
  const intervals = realSlots
    .map(slot => {
      const [start, end] = slot.split('–');
      const startM = timeToMinutes(start);
      return { label: slot, start: startM, end: end ? timeToMinutes(end) : startM + SLOT_MINUTES };
    })
    .sort((a, b) => a.start - b.start);

  const result: string[] = [];
  let cursor = startMin;
  for (const interval of intervals) {
    if (interval.start >= endMin) break;
    while (cursor + SLOT_MINUTES <= interval.start) {
      result.push(`${minutesToTime(cursor)}–${minutesToTime(cursor + SLOT_MINUTES)}`);
      cursor += SLOT_MINUTES;
    }
    result.push(interval.label);
    cursor = Math.max(cursor, interval.end);
  }
  while (cursor + SLOT_MINUTES <= endMin) {
    result.push(`${minutesToTime(cursor)}–${minutesToTime(cursor + SLOT_MINUTES)}`);
    cursor += SLOT_MINUTES;
  }
  return result;
}

// Program window per day: Mon-Thu always show the full 9am-6pm business day
// (even before it's filled in). Sunday's morning is satellite/registration
// only, so its grid starts at noon; Friday is a closing half-day, so both
// end early at whatever the last scheduled item actually is.
function dayWindow(dayOfWeek: string, realSlots: string[]): { startMin: number; endMin: number } {
  const lastRealEnd = realSlots.reduce((max, slot) => {
    const [, end] = slot.split('–');
    return end ? Math.max(max, timeToMinutes(end)) : max;
  }, 0);

  if (dayOfWeek === 'Sunday') {
    const startMin = 12 * 60;
    return { startMin, endMin: Math.max(lastRealEnd, startMin) };
  }
  if (dayOfWeek === 'Friday') {
    const startMin = 9 * 60;
    return { startMin, endMin: Math.max(lastRealEnd, startMin) };
  }
  return { startMin: 9 * 60, endMin: 18 * 60 };
}

const days = conferenceDays.map((day) => {
  const daySpeakers = getDaySpeakers(day.date);
  const dayBreaks = scheduleBreaks.filter(b => b.dates.includes(day.date));
  const timedBreaks = dayBreaks.filter(b => b.startTime);
  const tbdBreaks = dayBreaks.filter(b => !b.startTime);
  const rooms = ALL_ROOMS;
  const realTimeSlots = getTimeSlots(daySpeakers, timedBreaks);
  const { startMin, endMin } = dayWindow(day.dayOfWeek, realTimeSlots);
  const timeSlots = buildDaySlots(realTimeSlots, startMin, endMin);
  // Merge speakers and timed breaks into a single time-ordered agenda list
  // (used by the mobile/no-grid agenda view).
  const agendaEntries = [
    ...daySpeakers.map(s => ({ kind: 'speaker' as const, speaker: s, time: s.schedule?.startTime || '' })),
    ...timedBreaks.map(b => ({ kind: 'break' as const, brk: b, time: b.startTime || '' })),
  ].sort((a, b) => a.time.localeCompare(b.time));
  return {
    ...day,
    daySpeakers,
    timedBreaks,
    tbdBreaks,
    agendaEntries,
    rooms,
    timeSlots,
    // Header row stays auto-sized; each time-slot row is at least its
    // duration-scaled height, but can grow (pushing later rows down) when an
    // opened talk's abstract needs more room than that.
    gridTemplateRows: ['auto', ...timeSlots.map(slot => `minmax(${slotRowHeightPx(slot)}px, auto)`)].join(' '),
    // The grid's own time-filled window means there's always something to
    // show; only a day with a genuinely empty window falls back to the
    // "announced later" placeholder.
    hasEvents: timeSlots.length > 0,
    showGrid: true,
  };
});
---

<div class="synoptic-table">
  {/* Track legend */}
  <div class="flex flex-wrap gap-2 justify-center mb-8">
    {tracks.map((t) => (
      <a
        href={`/authors/classification#${t.code.toLowerCase()}`}
        class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium border ${t.borderClass} ${t.textClass} bg-white dark:bg-primary-800 hover:opacity-80 transition-opacity`}
        title={t.label}
      >
        <span class={`w-2 h-2 rounded-full ${t.dotClass}`}></span>
        {t.code}
      </a>
    ))}
  </div>

  {/* Day tabs */}
  <div class="flex gap-2 overflow-x-auto pb-2 mb-6 justify-start sm:justify-center scrollbar-thin" role="tablist">
    {days.map((day, i) => (
      <button
        type="button"
        role="tab"
        aria-selected={i === 0}
        class="day-tab-btn flex-shrink-0 px-4 py-2 rounded-xl border text-sm font-medium transition-all duration-200 whitespace-nowrap border-primary-200 dark:border-primary-700 text-primary-700 dark:text-primary-300 hover:bg-primary-50 dark:hover:bg-primary-700/50 aria-selected:bg-gradient-to-r aria-selected:from-primary-600 aria-selected:to-accent-600 aria-selected:text-white aria-selected:border-transparent aria-selected:shadow-md"
        data-day-target={day.date}
      >
        <span class="block">{day.dayOfWeek}</span>
        <span class="block text-xs opacity-80">{day.displayDate}</span>
      </button>
    ))}
  </div>

  {/* Day panels */}
  {days.map((day, i) => (
    <div class="day-panel" data-day-panel={day.date} hidden={i !== 0}>
      {day.note && (
        <p class="text-center text-sm text-primary-500 dark:text-primary-400 mb-6 italic">{day.note}</p>
      )}

      {day.tbdBreaks.length > 0 && (
        <p class="text-center text-xs text-primary-400 dark:text-primary-500 mb-6">
          {day.tbdBreaks.map((b) => `${b.emoji} ${b.label} — time TBD`).join(' · ')}
        </p>
      )}

      {day.hasEvents && (day.showGrid ? (
        /* Desktop matrix view: time x room grid */
        <div class="hidden md:block overflow-x-auto">
          <div
            class="grid gap-2 min-w-[640px]"
            style={`grid-template-columns: 8rem repeat(${day.rooms.length}, minmax(0, 1fr)); grid-template-rows: ${day.gridTemplateRows};`}
          >
            <div></div>
            {day.rooms.map((room) => (
              <div class="px-3 py-2 text-sm font-semibold text-primary-800 dark:text-primary-100 text-center bg-primary-100 dark:bg-primary-700 rounded-lg">
                {room}
              </div>
            ))}

            {day.timeSlots.map((slot) => {
              const slotBreak = day.timedBreaks.find((b) => `${b.startTime}–${b.endTime}` === slot);
              if (slotBreak) {
                return (
                  <>
                    <div class="px-2 py-3 text-xs font-mono text-primary-500 dark:text-primary-400 flex items-center">{slot}</div>
                    <div
                      class="rounded-lg border border-dashed border-primary-200 dark:border-primary-600 bg-primary-50 dark:bg-primary-800/40 flex items-center justify-center gap-2 text-sm font-medium text-primary-500 dark:text-primary-400 py-3"
                      style={`grid-column: span ${day.rooms.length};`}
                    >
                      <span aria-hidden="true">{slotBreak.emoji}</span>
                      <span>{slotBreak.label}{slotBreak.location ? ` — ${slotBreak.location}` : ''}</span>
                    </div>
                  </>
                );
              }
              return (
                <>
                  <div class="px-2 py-3 text-xs font-mono text-primary-500 dark:text-primary-400 flex items-center">{slot}</div>
                  {day.rooms.map((room) => {
                    const cellSpeakers = speakersFor(day.daySpeakers, slot, room);
                    return (
                      <div class="h-full">
                        {cellSpeakers.map((speaker) => {
                          const track = getTrack(speaker.classification);
                          return (
                            <details name={`synoptic-${day.date}`} class="group h-full rounded-lg border border-primary-100 dark:border-primary-700 bg-white dark:bg-primary-800 hover:shadow-md transition-shadow duration-200">
                              <summary class="cursor-pointer select-none list-none p-2.5">
                                <div class="flex items-start gap-1.5">
                                  {track && <span class={`w-1.5 h-1.5 mt-[5px] rounded-full flex-shrink-0 ${track.dotClass}`} title={track.label}></span>}
                                  <p class="text-xs font-semibold text-primary-900 dark:text-primary-100 leading-snug line-clamp-2">{speaker.title}</p>
                                </div>
                                <p class="text-[11px] font-medium text-primary-500 dark:text-primary-400 truncate mt-1">{speaker.name}</p>
                              </summary>
                              <div class="px-2.5 pb-2.5 text-xs text-primary-600 dark:text-primary-300">
                                <p class="text-primary-400 dark:text-primary-500">{speaker.affiliation}</p>
                                {speaker.abstract && <p class="mt-1.5 leading-relaxed">{speaker.abstract}</p>}
                              </div>
                            </details>
                          );
                        })}
                      </div>
                    );
                  })}
                </>
              );
            })}
          </div>
        </div>
      ) : null)}

      {!day.hasEvents && (
        <div class="text-center py-16 px-6 border-2 border-dashed border-primary-200 dark:border-primary-700 rounded-2xl">
          <svg class="w-10 h-10 mx-auto text-primary-300 dark:text-primary-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <p class="text-primary-500 dark:text-primary-400">Schedule for this day will be announced closer to the conference.</p>
        </div>
      )}

      {/* Agenda view: always available, used on mobile, and as the only
          view on desktop when there isn't enough data for a true grid */}
      <div class={day.showGrid ? 'md:hidden space-y-3' : 'space-y-3'}>
        {day.agendaEntries.map((entry) => {
          if (entry.kind === 'break') {
            const b = entry.brk;
            return (
              <div class="flex items-center gap-3 p-4 rounded-xl border border-dashed border-primary-200 dark:border-primary-600 bg-primary-50 dark:bg-primary-800/40">
                <span class="text-sm font-mono text-primary-400 dark:text-primary-500 w-24 flex-shrink-0">{b.startTime}–{b.endTime}</span>
                <span aria-hidden="true">{b.emoji}</span>
                <span class="flex-1 text-sm font-medium text-primary-500 dark:text-primary-400">{b.label}</span>
                {b.location && (
                  <span class="text-xs text-primary-400 dark:text-primary-500 hidden sm:inline flex-shrink-0">{b.location}</span>
                )}
              </div>
            );
          }
          const speaker = entry.speaker;
          const track = getTrack(speaker.classification);
          return (
            <details name={`synoptic-agenda-${day.date}`} class="group border border-primary-100 dark:border-primary-700 rounded-xl bg-white dark:bg-primary-800 overflow-hidden hover:shadow-md transition-shadow duration-200">
              <summary class="cursor-pointer select-none list-none flex items-center gap-3 p-4">
                <span class="text-sm font-mono text-primary-400 dark:text-primary-500 w-24 flex-shrink-0">
                  {speaker.schedule?.startTime || 'TBD'}{speaker.schedule?.endTime ? `–${speaker.schedule.endTime}` : ''}
                </span>
                {track && <span class={`w-2 h-2 rounded-full flex-shrink-0 ${track.dotClass}`} title={track.label}></span>}
                <span class="flex-1 min-w-0">
                  <span class="block text-sm font-medium text-primary-900 dark:text-primary-100">{speaker.title}</span>
                  <span class="block text-xs text-primary-500 dark:text-primary-400 mt-0.5">{speaker.name}</span>
                </span>
                {speaker.schedule?.room && (
                  <span class="text-xs text-primary-400 dark:text-primary-500 hidden sm:inline flex-shrink-0">{speaker.schedule.room}</span>
                )}
                <svg class="w-4 h-4 text-primary-400 flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </summary>
              <div class="px-4 pb-4 pt-0 text-sm text-primary-600 dark:text-primary-300 border-t border-primary-50 dark:border-primary-700">
                <p class="font-semibold text-primary-800 dark:text-primary-200 mt-3">{speaker.affiliation}</p>
                {speaker.session?.code && (
                  <p class="text-xs mt-1 text-primary-400 dark:text-primary-500">
                    Session {speaker.session.code}{speaker.session.name ? ` · ${speaker.session.name}` : ''}
                  </p>
                )}
                {speaker.abstract && <p class="mt-2 leading-relaxed">{speaker.abstract}</p>}
              </div>
            </details>
          );
        })}
      </div>
    </div>
  ))}
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.day-tab-btn');
  const panels = document.querySelectorAll<HTMLElement>('[data-day-panel]');

  function selectDay(target: string) {
    buttons.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.dayTarget === target)));
    panels.forEach((p) => {
      p.hidden = p.dataset.dayPanel !== target;
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => selectDay(btn.dataset.dayTarget!));
  });

  // If viewing during the conference itself, jump straight to today's agenda.
  const now = new Date();
  const todayISO = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
  const todayButton = Array.from(buttons).find((b) => b.dataset.dayTarget === todayISO);
  if (todayButton) {
    selectDay(todayISO);
    todayButton.scrollIntoView({ block: 'nearest', inline: 'center' });
  }

  // Opening a talk should bring its box to the top of the viewport (below
  // the sticky nav) instead of leaving it wherever it happened to expand.
  function scrollToTalk(details: HTMLElement) {
    const nav = document.querySelector('nav');
    const navHeight = nav ? nav.getBoundingClientRect().height : 0;
    const offset = 16;
    const top = details.getBoundingClientRect().top + window.scrollY - navHeight - offset;
    window.scrollTo({ top, behavior: 'smooth' });
  }

  // Native <details> has no built-in open/close transition, so animate the
  // content panel's height/opacity ourselves (mirrors CollapsibleContent.astro).
  const TALK_ANIM_MS = 280;

  // Tracks the latest animation "generation" per details element so that a
  // stale animation's cleanup (from one interrupted by rapid switching)
  // can't clobber styles set by a newer one that superseded it.
  const talkAnimGen = new WeakMap<HTMLDetailsElement, number>();

  function bumpGen(details: HTMLDetailsElement): number {
    const gen = (talkAnimGen.get(details) || 0) + 1;
    talkAnimGen.set(details, gen);
    return gen;
  }

  function animateTalkClose(details: HTMLDetailsElement, content: HTMLElement, onDone: () => void) {
    const gen = bumpGen(details);
    content.getAnimations().forEach((a) => a.cancel());
    content.style.overflow = 'hidden';
    const startHeight = content.getBoundingClientRect().height;
    const anim = content.animate(
      [{ height: `${startHeight}px`, opacity: 1 }, { height: '0px', opacity: 0 }],
      { duration: TALK_ANIM_MS, easing: 'ease-in', fill: 'forwards' }
    );
    anim.finished
      .then(() => {
        if (talkAnimGen.get(details) !== gen) return; // superseded, its own animation owns cleanup
        details.open = false;
        content.style.overflow = '';
        content.style.height = '';
        content.style.opacity = '';
        onDone();
      })
      .catch(() => {});
  }

  function animateTalkOpen(details: HTMLDetailsElement, content: HTMLElement) {
    const gen = bumpGen(details);
    content.getAnimations().forEach((a) => a.cancel());
    content.style.overflow = 'hidden';
    content.style.height = 'auto';
    const targetHeight = content.getBoundingClientRect().height;
    content.style.height = '0px';
    const anim = content.animate(
      [{ height: '0px', opacity: 0 }, { height: `${targetHeight}px`, opacity: 1 }],
      { duration: TALK_ANIM_MS, easing: 'cubic-bezier(0.4, 0, 0.2, 1)', fill: 'forwards' }
    );
    // Scroll alongside the opening animation instead of waiting for it to
    // finish; the box's own top position doesn't move as it grows downward.
    requestAnimationFrame(() => scrollToTalk(details));
    anim.finished
      .then(() => {
        if (talkAnimGen.get(details) !== gen) return;
        content.style.overflow = '';
        content.style.height = '';
        content.style.opacity = '';
      })
      .catch(() => {});
  }

  document.querySelectorAll<HTMLDetailsElement>('details[name^="synoptic-"]').forEach((details) => {
    const summary = details.querySelector('summary');
    const content = details.querySelector(':scope > div') as HTMLElement | null;
    if (!summary || !content) return;

    summary.addEventListener('click', (e) => {
      e.preventDefault();

      if (details.open) {
        animateTalkClose(details, content, () => {});
        return;
      }

      const openThis = () => {
        details.open = true;
        animateTalkOpen(details, content);
      };

      // Close the currently-open talk in this group (with the same smooth
      // animation) before opening this one, instead of letting the browser's
      // native same-`name` exclusivity snap it shut mid-animation.
      const groupName = details.getAttribute('name');
      const openSibling = groupName
        ? (document.querySelector(`details[name="${groupName}"][open]`) as HTMLDetailsElement | null)
        : null;
      const siblingContent = openSibling?.querySelector(':scope > div') as HTMLElement | null;

      if (openSibling && openSibling !== details && siblingContent) {
        animateTalkClose(openSibling, siblingContent, openThis);
      } else {
        openThis();
      }
    });
  });
</script>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .scrollbar-thin::-webkit-scrollbar {
    height: 6px;
  }
  .scrollbar-thin::-webkit-scrollbar-thumb {
    background-color: theme('colors.primary.300');
    border-radius: 9999px;
  }
</style>
