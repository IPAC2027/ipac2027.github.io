---
import type { Speaker, SpeakerType } from '../data/speakers';
import { speakers } from '../data/speakers';
import { getTrack, tracks } from '../data/synopticSchedule';

export interface Props {
  types?: SpeakerType[];
}

const { types = ['plenary', 'invited', 'contributed'] } = Astro.props;

const groupLabels: Record<SpeakerType, string> = {
  plenary: 'Plenary Speakers',
  invited: 'Invited Speakers',
  contributed: 'Contributed Speakers',
};

const groupDescriptions: Record<SpeakerType, string> = {
  plenary: 'Highlighted talks opening and closing the conference program.',
  invited: 'Experts invited to present the latest developments in their field.',
  contributed: 'Speakers selected from contributed abstract submissions.',
};

function getInitials(name: string): string {
  return name
    .split(' ')
    .filter(Boolean)
    .map(part => part[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
}

function getLastName(name: string): string {
  const parts = name.trim().split(/\s+/);
  return parts[parts.length - 1];
}

// Build an inline style for a speaker photo based on its optional adjustment
// (position/zoom), so individual photos can be fine-tuned without touching markup.
// `transform-origin` is set to match `position` so `zoom` scales around the
// same focal point instead of the frame's center, which is otherwise the
// default pivot for `transform: scale()` regardless of `object-position`.
function getPhotoStyle(adjustment?: Speaker['photoAdjustment']): string {
  const position = adjustment?.position || 'center';
  const zoom = adjustment?.zoom || 1;
  return `object-position: ${position}; transform-origin: ${position}; transform: scale(${zoom});`;
}

const groups = types
  .map(type => ({
    type,
    label: groupLabels[type],
    description: groupDescriptions[type],
    items: type === 'invited'
      ? [...speakers.filter(s => s.type === type)].sort((a, b) => getLastName(a.name).localeCompare(getLastName(b.name)))
      : speakers.filter(s => s.type === type),
  }))
  .filter(group => group.items.length > 0);
---

{groups.length === 0 ? (
  <div class="text-center py-8">
    <p class="text-primary-600 dark:text-primary-300">Speaker information will be announced soon. Please check back for updates.</p>
  </div>
) : (
  <div class="space-y-16">
    {groups.map((group) => (
      <section>
        <div class="mb-8">
          <h2 class="text-3xl font-heading font-bold text-primary-900 dark:text-primary-100">{group.label}</h2>
          <p class="mt-2 text-primary-600 dark:text-primary-300">{group.description}</p>
        </div>

        {group.type === 'invited' && (
          <div class="mb-8 flex flex-wrap gap-2 justify-center">
            {tracks.map((track) => (
              <a
                href={`/authors/classification#${track.code.toLowerCase()}`}
                title={track.label}
                class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium border ${track.borderClass} ${track.textClass} bg-white dark:bg-primary-800 hover:opacity-80 transition-opacity`}
              >
                <span class={`w-2 h-2 rounded-full ${track.dotClass}`}></span>
                {track.code}
              </a>
            ))}
          </div>
        )}

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {group.items.map((speaker: Speaker) => {
            const track = getTrack(speaker.classification);
            return (
            <div data-speaker-card class="group relative flex flex-col bg-white dark:bg-primary-800 rounded-2xl border border-primary-100 dark:border-primary-700 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 overflow-hidden">
              {/* Accent top bar, color-coded by MC track (same colors as the synoptic table) */}
              <div class={`h-1.5 w-full ${track ? track.gradientClass : 'bg-gradient-to-r from-primary-500 to-accent-500'}`}></div>

              <div class="p-6 flex flex-col items-center text-center flex-1">
                {speaker.photo ? (
                  <div class="w-24 h-24 rounded-full overflow-hidden ring-4 ring-primary-50 dark:ring-primary-700 shadow-md">
                    <img
                      src={speaker.photo}
                      alt={speaker.name}
                      class="w-full h-full object-cover"
                      style={getPhotoStyle(speaker.photoAdjustment)}
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <div class="w-24 h-24 rounded-full bg-gradient-to-br from-primary-500 to-accent-500 flex items-center justify-center text-white text-2xl font-heading font-semibold shadow-md">
                    {getInitials(speaker.name)}
                  </div>
                )}

                <h3 class="mt-4 text-lg font-heading font-semibold text-primary-900 dark:text-primary-100">
                  {speaker.name}
                </h3>
                <p class="text-sm text-primary-500 dark:text-primary-400">{speaker.affiliation}</p>

                {speaker.title && (
                  <div class="mt-4 pt-4 border-t border-primary-100 dark:border-primary-700 w-full">
                    <p class="text-sm font-semibold text-primary-800 dark:text-primary-200 leading-snug">
                      {speaker.title}
                    </p>
                  </div>
                )}

                {speaker.bio && (
                  <details name="speaker-details" class="group mt-4 w-full text-left">
                    <summary class="cursor-pointer select-none text-sm font-medium text-accent-600 dark:text-accent-400 hover:text-accent-700 dark:hover:text-accent-300 list-none flex items-center justify-center gap-1">
                      <span>{speaker.abstract ? 'Read bio and abstract' : 'Read bio'}</span>
                      <svg class="w-4 h-4 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </summary>
                    <p class="mt-3 text-sm text-primary-600 dark:text-primary-300 leading-relaxed whitespace-pre-line">
                      {speaker.bio}
                    </p>
                    {speaker.abstract && (
                      <>
                        <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-primary-400 dark:text-primary-500">Abstract</p>
                        <p class="mt-1 text-sm text-primary-600 dark:text-primary-300 leading-relaxed whitespace-pre-line">
                          {speaker.abstract}
                        </p>
                      </>
                    )}
                  </details>
                )}
              </div>
            </div>
            );
          })}
        </div>
      </section>
    ))}
  </div>
)}

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
  details[open] summary svg {
    transform: rotate(180deg);
  }
</style>

<script>
  // Keep only one speaker's bio/abstract open at a time, and bring the
  // newly-opened card to the top of the viewport (below the sticky nav) so
  // expanding a lower card doesn't leave the page in a confusing scroll spot.
  document.addEventListener('DOMContentLoaded', () => {
    const detailsElements = document.querySelectorAll<HTMLDetailsElement>('details[name="speaker-details"]');

    function scrollCardToTop(el: HTMLElement) {
      const nav = document.querySelector('nav');
      const navHeight = nav ? nav.getBoundingClientRect().height : 0;
      const offset = 16;
      const top = el.getBoundingClientRect().top + window.scrollY - navHeight - offset;
      window.scrollTo({ top, behavior: 'smooth' });
    }

    detailsElements.forEach((details) => {
      details.addEventListener('toggle', () => {
        if (!details.open) return;

        // Native `name`-grouped <details> close siblings synchronously, so by
        // the time this fires the layout reflow from closing others is already
        // queued. Wait a frame before measuring/scrolling for an accurate position.
        requestAnimationFrame(() => {
          const card = details.closest<HTMLElement>('[data-speaker-card]');
          scrollCardToTop(card || details);
        });
      });
    });
  });
</script>
